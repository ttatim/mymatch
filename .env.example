DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mymatch
DB_USER=postgres
DB_PASSWORD=troque_esta_senha
APP_ENV=development
# Em produção, diretório absoluto fora da raiz servida pelo servidor web.
UPLOAD_DIRECTORY=/var/lib/mymatch/uploads
# Gere com: php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
APP_ENCRYPTION_KEY=troque_por_uma_chave_base64_de_32_bytes
# URL pública usada no e-mail de recuperação. O servidor PHP precisa ter envio de e-mail configurado.
APP_BASE_URL=https://app.exemplo.com
